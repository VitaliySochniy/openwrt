do_config_generate() {
	local generate

	[ -s /etc/board-base.json ] || {
		[ -s /tmp/board.json ] || ubootenv_preinit_config

		echo "- generating board file -"
		generate=1
	}

	/bin/board_detect
	rm -f /tmp/fw_env.preinit.config

	[ -n "$generate" ] && /bin/config_generate > /dev/null
}

boot_hook_add preinit_main do_config_generate
boot_hook_add initramfs do_config_generate
